# ============================================================
# RMC File Server — Environment Variables
# Copy to .env and fill in values. Never commit .env.
# ============================================================

NODE_ENV=development
PORT=3002

# Allowed origins (comma-separated) for CORS
# Include both backend and frontend URLs
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://isengesho.com,https://www.isengesho.com

# ── JWT (must match backend JWT_ACCESS_SECRET) ────────────────
# generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=

# ── Storage driver ────────────────────────────────────────────
# "disk" stores files on the local filesystem — easiest for dev, no MinIO/Docker.
# "s3" uses the S3/MinIO settings below. STORAGE_DISK_DIR defaults to an
# absolute <cwd>/storage-data when left empty (it must be absolute).
STORAGE_DRIVER=disk
STORAGE_DISK_DIR=
FILE_SERVER_PUBLIC_URL=http://localhost:3002

# ── S3 / MinIO Storage (used when STORAGE_DRIVER=s3) ──────────
# For local dev with MinIO:
#   S3_ENDPOINT=http://localhost:9000
# For AWS S3, leave S3_ENDPOINT empty (SDK will use default endpoint)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_NAME=rmc-files
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# ── Upload limits (managed via admin Settings → Upload Settings) ──────────────
# Upload constraints are stored in the main backend database and fetched
# dynamically. Configure them at: Admin → Settings → Upload Settings.

# URL of the main backend API (used to fetch dynamic upload settings)
BACKEND_URL=http://localhost:3000/api/v1

# Presigned URL expiry in seconds (default: 3600 = 1 hour)
PRESIGNED_URL_EXPIRY=3600
