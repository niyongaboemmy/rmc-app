# ============================================================
# RMC Frontend — Environment Variables
# Copy to .env.local and fill in values. Never commit .env.local.
# ============================================================

# Port the Next.js dev server listens on
PORT=3001

# Backend API base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# File server base URL for displaying uploaded assets
NEXT_PUBLIC_FILE_SERVER_URL=http://localhost:3002

# App URL (used for absolute links in emails, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Default locale
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Anthropic API key for the "Ask AI" assistant (server-side only — never expose to the client).
# Get one at https://console.anthropic.com/ . The assistant is disabled until this is set.
ANTHROPIC_API_KEY=
