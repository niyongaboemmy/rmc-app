# ============================================================
# RMC Frontend — Environment Variables
# Copy to .env.local and fill in values. Never commit .env.local.
# ============================================================

# Port the Next.js dev server listens on
PORT=3001

# Backend API base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# File server base URL for displaying uploaded assets
NEXT_PUBLIC_FILE_SERVER_URL=http://localhost:3002

# App URL (used for absolute links in emails, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Default locale
NEXT_PUBLIC_DEFAULT_LOCALE=en

# The "Ask AI" assistant is configured by the site admin in the dashboard
# (Admin → Settings → AI Assistant), NOT via env vars. The provider API key is
# stored encrypted in the database on the backend. Nothing to set here for AI.

# OpenRouteService API key for in-app mosque directions on the Contact page.
# Client-side (NEXT_PUBLIC_*). Get a free key at https://openrouteservice.org/dev/#/signup .
# If unset, directions fall back to a straight-line route.
NEXT_PUBLIC_ORS_API_KEY=

NEXT_PUBLIC_ORS_API_KEY=eyJvcmciOiI1YjNjZTM1OTc4NTExMTAwMDFjZjYyNDgiLCJpZCI6ImEzZGNmZTYzZjJiNDQyNDBiNGU5YzUxNGMyYTY0ZTM1IiwiaCI6Im11cm11cjY0In0=
