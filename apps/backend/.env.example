# ============================================================
# RMC Backend — Environment Variables
# Copy to .env and fill in values. Never commit .env.
# ============================================================

NODE_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000

# Number of reverse proxies between the internet and this app. MUST be set in
# any deployment that sits behind one.
#
# Rate limiting and the auth audit log key on the client IP. Behind a proxy the
# socket address is the proxy's own, so with this left at 0 every user shares a
# single rate-limit bucket and they lock each other out of login — and every
# audit row records the proxy's address instead of the user's.
#
# Do not "fix" that by trusting blindly: X-Forwarded-For is client-supplied, so
# an over-large value lets an attacker prepend a fake IP, mint a fresh bucket
# per request, and bypass the limits altogether. The value is a count of the
# proxies you actually run, and each must overwrite (not append to) the header.
#
#   0  direct exposure, no proxy            (the default)
#   1  nginx / ALB / Cloudflare alone
#   2  Cloudflare in front of nginx
#
# TRUST_PROXY_HOPS=1

# Local development only: when set to "true" (and NODE_ENV is not "production"),
# the marriage wizard can mark MoMo payments as completed WITHOUT charging, so
# you can reach the provisional certificate locally. Leave this commented/unset.
# NEVER enable it in production — it would let users pay 0 for a certificate.
# ENABLE_DEV_PAYMENT_BYPASS=true

# Allowed frontend origin (CORS)
FRONTEND_URL=http://localhost:3001

# File server URL (used to build public asset URLs returned in API responses)
FILE_SERVER_URL=http://localhost:3002

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://rmc_user:password@localhost:5432/rmc_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=rmc_db
DATABASE_USER=rmc_user
DATABASE_PASSWORD=

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://:password@localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── JWT — generate with: openssl rand -hex 64 ─────────────────
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRY=7d

# ── Security ──────────────────────────────────────────────────
BCRYPT_ROUNDS=12
OTP_EXPIRY_MINUTES=5
PASSWORD_RESET_EXPIRY_MINUTES=15

# Encryption key used to protect sensitive values stored in the database
# (e.g. SMS gateway password). Generate with: openssl rand -hex 32
# Must NOT change after initial setup — changing it invalidates all encrypted DB values.
APP_ENCRYPTION_KEY=

# ── MFA ───────────────────────────────────────────────────────
MFA_APP_NAME=RMC Platform

# ── Social Feed (home page "Latest on Social Media") ──────────
# The backend polls these accounts on a schedule and caches the latest posts,
# which then appear on the landing page automatically. Leave a platform's vars
# blank to skip it (that platform falls back to admin-managed content).
SOCIAL_FEED_ENABLED=true
SOCIAL_FEED_POLL_MINUTES=15
SOCIAL_FEED_MAX_POSTS=12
META_GRAPH_VERSION=v21.0

# YouTube Data API v3 — public API key + channel id (starts with "UC...").
# Key: https://console.cloud.google.com → enable "YouTube Data API v3".
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# Facebook Page (Graph API) — page id + a long-lived Page access token.
# Needs a Meta App with pages_read_engagement; token from Graph API Explorer.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# Instagram (Graph API) — Business/Creator account linked to the FB page above.
# INSTAGRAM_USER_ID is the IG user id; token defaults to FACEBOOK_PAGE_ACCESS_TOKEN.
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# Twitter / X API v2 — reading a user timeline requires a PAID plan.
# TWITTER_USER_ID is the numeric account id (not the @handle).
TWITTER_BEARER_TOKEN=
TWITTER_USER_ID=

# ── Email (MailHog in dev, real SMTP in prod) ─────────────────
# Production: SMTP_HOST=smtp.sendgrid.net SMTP_PORT=587 SMTP_USER=apikey SMTP_PASS=<key>
# Dev: run `npx mailhog` and use defaults below (web UI at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@rmc.org.rw
# Set SMTP_SECURE=true for port 465 (TLS), false for STARTTLS on 587 / 1025
SMTP_SECURE=false

# ── Initial Admin Seed ─────────────────────────────────────────
# These are used only by `npm run seed` to bootstrap the superadmin account.
# Change them immediately after first deploy.
ADMIN_EMAIL=admin@rmc.org.rw
ADMIN_PASSWORD=Admin@RMC2024!
ADMIN_PHONE=+250788000000

# ── Tracking OTP (public application-status lookup) ───────────
# Server-side pepper mixed into OTP hashes; generate with: openssl rand -hex 32
TRACKING_OTP_PEPPER=
# Secret for the short-lived tracking session token; openssl rand -hex 48
TRACKING_TOKEN_SECRET=
# LOCAL DEV ONLY — fixed code that verifies any tracking session, for machines
# with no SMS gateway. Ignored unless NODE_ENV is non-production; setting it in
# production is refused and logged as an error at boot. Leave EMPTY everywhere
# except your own machine.
TRACKING_OTP_DEV_CODE=

# ── IremboPay (sandbox smoke test + one-shot settings bootstrap) ───────────────
# These are ONLY read by scripts/irembopay-sandbox-smoke.ts and
# scripts/irembopay-configure.ts. The running application never reads IremboPay
# credentials from the environment — it reads them from payment_method_settings,
# so an admin can rotate keys or flip sandbox→production from the settings UI
# with no redeploy.
#
# Get them from the IremboPay portal (one-time, per environment):
#   Secret + public key  → Integration Details → View Token
#   Payment account      → Payment Accounts (fixes the invoice currency)
#   Product code(s)      → Products
#   Callback URL         → set to  https://<api-host>/api/v1/webhooks/irembopay
#
# NEVER commit real values. This file is a template; the real ones live in your
# gitignored .env or the team password manager.
IREMBOPAY_SECRET_KEY=
IREMBOPAY_PUBLIC_KEY=
IREMBOPAY_ACCOUNT=
IREMBOPAY_PRODUCT_CODE=
# Optional — leave empty to derive from the Test mode toggle in the settings UI.
IREMBOPAY_API_BASE=
IREMBOPAY_TEST_MSISDN=0781234567
